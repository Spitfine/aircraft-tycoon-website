<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{ update.title.en }} — Aircraft Tycoon</title>
<meta name="description" content="{{ update.description }}"/>
<link rel="canonical" href="{{ update.canonicalUrl }}"/>
<meta property="og:type" content="article"/>
<meta property="og:title" content="{{ update.title.en }}"/>
<meta property="og:description" content="{{ update.socialDescription }}"/>
<meta property="og:url" content="{{ update.canonicalUrl }}"/>
<meta property="og:image" content="{{ update.cover.absoluteUrl }}"/>
<meta property="article:published_time" content="{{ update.publicationDate }}"/>
<meta name="twitter:card" content="summary_large_image"/>
<link rel="stylesheet" href="/assets/css/site.css"/>
<link rel="stylesheet" href="/assets/css/updates.css"/>
</head>
<body>
<header class="nav"><div class="wrap navin"><a class="brand" href="/"><span class="brandmark">AT</span><span>Aircraft Tycoon</span></a><nav aria-label="Main navigation" class="links"><a href="/">Home</a><a href="/updates/">Updates</a><a href="mailto:contact@aircraft-tycoon.com">Contact</a><div class="lang" aria-label="Language"><button class="active" id="en" type="button">EN</button><button id="pt" type="button">PT</button></div></nav></div></header>
<main class="updates-page">
<header class="article-header">
<div class="wrap language-copy" data-lang="en"><div class="update-meta"><span>{{ update.displayDate.en }}</span><span>{{ update.type.en }}</span><span>{{ update.category }}</span></div><h1>{{ update.title.en }}</h1><p class="article-deck">{{ update.deck.en }}</p></div>
<div class="wrap language-copy" data-lang="pt" hidden><div class="update-meta"><span>{{ update.displayDate.pt }}</span><span>{{ update.type.pt }}</span><span>{{ update.category }}</span></div><h1>{{ update.title.pt }}</h1><p class="article-deck">{{ update.deck.pt }}</p></div>
</header>
<section class="section"><div class="wrap article-shell">
{{ content | safe }}
<aside class="article-sidebar"><div class="language-copy" data-lang="en"><h3>{{ update.sidebar.title.en }}</h3><p>{{ update.sidebar.copy.en }}</p><div class="article-actions"><a class="btn secondary" href="/updates/">All updates</a><a class="btn secondary" href="/">Official website</a></div></div><div class="language-copy" data-lang="pt" hidden><h3>{{ update.sidebar.title.pt }}</h3><p>{{ update.sidebar.copy.pt }}</p><div class="article-actions"><a class="btn secondary" href="/updates/">Todas as atualizações</a><a class="btn secondary" href="/">Website oficial</a></div></div></aside>
</div>
<div class="wrap steam-update-section"><div class="language-copy" data-lang="en"><div class="kicker">{{ update.steam.kicker.en }}</div><h2>{{ update.steam.title.en }}</h2><p class="copy">{{ update.steam.copy.en }}</p></div><div class="language-copy" data-lang="pt" hidden><div class="kicker">{{ update.steam.kicker.pt }}</div><h2>{{ update.steam.title.pt }}</h2><p class="copy">{{ update.steam.copy.pt }}</p></div><div class="steam-update-widget-column"><div class="steam-widget-viewport" id="steam-update-widget-viewport"><iframe allowfullscreen="" class="steam-widget-frame" frameborder="0" height="190" id="steam-update-widget" loading="lazy" width="646" data-src-en="{{ update.steam.widget.en }}" data-src-pt="{{ update.steam.widget.pt }}" title="Aircraft Tycoon on Steam"></iframe></div></div></div>
</section>
</main>
<footer class="footer"><div class="wrap footerin"><div><div class="brand"><span class="brandmark">AT</span><span>Aircraft Tycoon</span></div><p>Independent historical aviation management game.</p></div><div style="max-width:500px;font-size:13px">All visuals are work in progress and do not represent final quality or guaranteed final content.</div></div></footer>
<script src="/assets/js/updates.js"></script>
</body>
</html>
